@{
    ViewData["Title"] = "Errore";
    Layout = "_Layout";
}

<div class="error404-wrapper">
    <div class="error404-content">
        <p class="error404-code">500</p>
        <h1>Qualcosa è andato storto</h1>
        <p class="error404-sub">Si è verificato un errore interno. Riprova tra qualche momento ☕</p>
        <a asp-controller="Home" asp-action="Index" class="btn-ordina"
           style="display:inline-block; margin-top:1.5rem; text-decoration:none;">
            Torna al menu
        </a>
    </div>
</div>