@{
    ViewData["Title"] = "Nuova password";
    Layout = "_Layout";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <h2>Nuova password</h2>
            <p>Rispondi alla domanda di sicurezza per reimpostare la password</p>
        </div>

        <form method="post" asp-action="ResetPassword" asp-controller="Home">
            <input type="hidden" name="username" value="@ViewBag.Username"/>

            <div class="form-group">
                <label>Domanda di sicurezza</label>
                <p class="auth-domanda">@ViewBag.Domanda</p>
            </div>
            <div class="form-group">
                <label>La tua risposta</label>
                <input type="text" name="risposta" placeholder="Risposta segreta" required/>
            </div>
            <div class="form-group">
                <label>Nuova password</label>
                <input type="password" name="nuovaPassword" placeholder="Scegli una nuova password" required/>
            </div>

            @if (ViewData["errore"] != null)
            {
                <p class="auth-error">@ViewData["errore"]</p>
            }

            <button type="submit" class="auth-btn">Reimposta password</button>
        </form>

        <p class="auth-switch">
            <a asp-action="Login" asp-controller="Home">Torna al login</a>
        </p>
    </div>
</div>
