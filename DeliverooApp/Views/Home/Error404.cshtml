@{
    ViewData["Title"] = "Pagina non trovata";
    Layout = "_Layout";
}

<div class="error404-wrapper">
    <div class="error404-content">
        <p class="error404-code">404</p>
        <h1>Pagina non trovata</h1>
        <p class="error404-sub">Sembra che tu abbia ordinato qualcosa che non è nel nostro menu ☕</p>
        <a asp-controller="Home" asp-action="Index" class="btn-ordina" 
           style="display:inline-block; margin-top:1.5rem; text-decoration:none;">
            Torna al menu
        </a>
    </div>
</div>