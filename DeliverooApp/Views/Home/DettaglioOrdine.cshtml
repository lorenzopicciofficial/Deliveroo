@model DeliverooApp.Models.Ordine
@{
    ViewData["Title"] = "Dettaglio Ordine #" + Model.IdOrdine;
    Layout = "_Layout";
    var righe = ViewBag.Righe as List<DeliverooApp.Models.RigaDettaglio>;
    var articoli = ViewBag.Articoli as List<DeliverooApp.Models.Articolo>;
    var carta = ViewBag.Carta as DeliverooApp.Models.Carta;
    bool isAdmin = Context.Session.GetString("ruolo") == "admin";
    bool isConsegnato = Model.Stato.ToLower() == "consegnato";
    string numeroFattura = "FAT-" + Model.Data.Year + "-" + Model.IdOrdine.ToString("D5");
}

<div class="ordini-wrapper">

    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1rem;">
        @{
            string from = Context.Request.Query["from"];
            string backAction = from == "miei" ? "MieiOrdini" : (isAdmin ? "ElencoOrdini" : "MieiOrdini");
        }
        <a class="dettaglio-back" style="margin-bottom:0" asp-action="@backAction">
            ← Torna agli ordini
        </a>
        @if (isConsegnato)
        {
            <button class="btn-export" onclick="scaricaFattura()" style="display:flex; align-items:center; gap:.4rem;">
                Scarica fattura
            </button>
        }
    </div>

    <div class="ordini-header">
        <div>
            <p class="hero-eyebrow">Ordine #@Model.IdOrdine</p>
            <h1 class="ordini-title">Dettaglio ordine</h1>
        </div>
        <span class="stato-badge stato-@Model.Stato.ToLower().Replace(" ", "_")">
            @Model.Stato
        </span>
    </div>

    @if (Model.Stato == "in attesa" && Model.DataConferma.HasValue)
    {
    <div class="delivery-bar-section"
         data-conferma="@DateTime.SpecifyKind(Model.DataConferma.Value, DateTimeKind.Utc).ToString("o")"
         data-tempo="@Model.TempoStimato"
         id="deliverySection">
        <div class="delivery-bar-header">
            <div class="delivery-bar-icon-wrap">🛵</div>
            <div>
                <p class="delivery-bar-label">Il rider è in arrivo</p>
                <p class="delivery-bar-sub" id="deliveryTimeLeft">Calcolo tempo...</p>
            </div>
        </div>
        <div class="delivery-bar-track">
            <div class="delivery-bar-fill" id="deliveryFill"></div>
        </div>
        <div class="delivery-bar-labels">
            <span>Ordine confermato</span>
            <span>Consegnato</span>
        </div>
    </div>
    }
    @if (Model.Stato == "consegnato" && Model.DataConsegna.HasValue)
    {
    <div class="delivery-bar-section delivery-completed-section">
        <div class="delivery-bar-header">
            <div class="delivery-bar-icon-wrap">✅</div>
            <div>
                <p class="delivery-bar-label">Ordine consegnato</p>
                <p class="delivery-bar-sub">@Model.DataConsegna.Value.ToString("dddd d MMMM yyyy") alle ore @Model.DataConsegna.Value.ToString("HH:mm")</p>
            </div>
        </div>
    </div>
    }

    <div class="stats-grid" style="margin-bottom: 2rem;">
        <div class="stat-card">
            <p class="stat-label">Cliente</p>
            <p class="stat-value" style="font-size: 1.2rem;">@Model.NomeCliente</p>
            <p class="stat-sub">@Model.Indirizzo</p>
        </div>
        <div class="stat-card">
            <p class="stat-label">Data ordine</p>
            <p class="stat-value" style="font-size: 1.2rem;">@Model.Data.ToString("dd MMM yyyy")</p>
            <p class="stat-sub">ore @Model.Data.ToString("HH:mm")</p>
        </div>
        <div class="stat-card stat-card-highlight">
            <p class="stat-label">Totale ordine</p>
            <p class="stat-value">€ @Model.ImportoTotale.ToString("0.00")</p>
            <p class="stat-sub">@(righe?.Count ?? 0) articoli</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Note))
    {
    <div class="stat-card" style="margin-bottom:2rem; grid-column:1/-1">
        <p class="stat-label">Note</p>
        <p style="margin:0; white-space:pre-wrap;">@Model.Note</p>
    </div>
    }

    <div class="ordine-carta-section">
        @if (carta != null)
        {
            <div class="ordine-carta-preview">
                <div class="carta-chip"></div>
                <p class="carta-numero">**** **** **** @carta.Ultime4Cifre</p>
                <div class="carta-bottom">
                    <div>
                        <p class="carta-label">Intestatario</p>
                        <p class="carta-value">@carta.Intestatario.ToUpper()</p>
                    </div>
                    <div>
                        <p class="carta-label">Scadenza</p>
                        <p class="carta-value">@carta.Scadenza</p>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="ordine-carta-skip">
                <p>💵 Pagato in contanti</p>
            </div>
        }
    </div>

    @if (righe == null || righe.Count == 0)
    {
        <div class="ordini-empty">
            <p>Nessun articolo trovato per questo ordine.</p>
        </div>
    }
    else
    {
        <div class="ordini-table-wrap">
            <table class="ordini-table">
                <thead>
                    <tr>
                        <th>Articolo</th>
                        <th>Categoria</th>
                        <th>Quantità</th>
                        <th>Prezzo unitario</th>
                        <th>Subtotale</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < righe.Count; i++)
                    {
                        var riga = righe[i];
                        var articolo = i < articoli.Count ? articoli[i] : null;
                        <tr>
                            <td class="td-name">@(articolo?.Nome ?? "Articolo non trovato")</td>
                            <td class="td-muted">@(articolo?.Categoria ?? "-")</td>
                            <td class="td-muted">@riga.Quantita</td>
                            <td class="td-muted">€ @riga.Prezzo.ToString("0.00")</td>
                            <td class="td-price">€ @((riga.Quantita * riga.Prezzo).ToString("0.00"))</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" style="padding: 16px; text-align: right; font-weight: 600;" class="td-totale-label">
                            Totale
                        </td>
                        <td style="padding: 16px; font-family: 'Syne', sans-serif; font-size: 1.1rem; font-weight: 800;" class="td-totale-value">
                            € @Model.ImportoTotale.ToString("0.00")
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>

<!-- TEMPLATE FATTURA (nascosto) -->
<div id="fatturaPdf" style="display:none">
    <div style="font-family: Arial, sans-serif; max-width: 800px; margin: 0 auto; padding: 40px; background: #fff; color: #1c1a18;">

        <!-- HEADER -->
        <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:40px; padding-bottom:24px; border-bottom:3px solid #b8936a;">
            <div>
                <div style="font-size:2rem; font-weight:800; letter-spacing:-1px; color:#1c1a18;">
                    Caffè <span style="color:#b8936a;">Ritmo</span>
                </div>
                <div style="font-size:11px; color:#8a8278; margin-top:6px;">Caffè Ritmo S.r.l.</div>
                <div style="font-size:11px; color:#8a8278;">Via del Caffè 1 — 20121 Milano (MI)</div>
                <div style="font-size:11px; color:#8a8278;">P.IVA: IT 04 7823 1902 84</div>
                <div style="font-size:11px; color:#8a8278;">Cod. Fiscale: 04782319028</div>
                <div style="font-size:11px; color:#8a8278;">REA: MI-2341892</div>
                <div style="font-size:11px; color:#8a8278;">privacy@caffèritmo.it</div>
            </div>
            <div style="text-align:right;">
                <div style="font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:2px; color:#b8936a; margin-bottom:4px;">Documento di acquisto</div>
                <div style="font-size:1.5rem; font-weight:800; color:#1c1a18;">@numeroFattura</div>
                <div style="font-size:11px; color:#8a8278; margin-top:6px;">Data emissione</div>
                <div style="font-size:13px; font-weight:600; color:#1c1a18;">@Model.Data.ToString("dd MMMM yyyy")</div>
                <div style="font-size:11px; color:#8a8278; margin-top:4px;">ore @Model.Data.ToString("HH:mm")</div>
            </div>
        </div>

        <!-- DATI CLIENTE -->
        <div style="display:flex; gap:24px; margin-bottom:32px;">
            <div style="flex:1; background:#f7f4ef; border-radius:12px; padding:20px;">
                <div style="font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:1px; color:#8a8278; margin-bottom:8px;">Intestato a</div>
                <div style="font-size:1rem; font-weight:700; color:#1c1a18;">@Model.NomeCliente</div>
                <div style="font-size:13px; color:#8a8278; margin-top:4px;">@Model.Indirizzo</div>
                @if (carta != null)
                {
                    <div style="font-size:12px; color:#8a8278; margin-top:8px; padding-top:8px; border-top:1px solid #e8ddd8;">
                        Pagato con carta **** @carta.Ultime4Cifre
                    </div>
                }
            </div>
            <div style="flex:1; background:#f7f4ef; border-radius:12px; padding:20px;">
                <div style="font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:1px; color:#8a8278; margin-bottom:8px;">Riferimento ordine</div>
                <div style="font-size:1rem; font-weight:700; color:#1c1a18;">Ordine #@Model.IdOrdine</div>
                <div style="font-size:13px; color:#8a8278; margin-top:4px;">@Model.Data.ToString("dd MMM yyyy, HH:mm")</div>
                <div style="margin-top:8px; padding-top:8px; border-top:1px solid #e8ddd8;">
                    <span style="display:inline-block; padding:3px 14px; border-radius:50px; font-size:12px; font-weight:600; background:#d4f5e9; color:#1a7a4a;">
                        Consegnato
                    </span>
                </div>
            </div>
        </div>

        <!-- TABELLA ARTICOLI -->
        <table style="width:100%; border-collapse:collapse; margin-bottom:24px;">
            <thead>
                <tr style="background:#1c1a18;">
                    <th style="padding:12px 16px; text-align:left; font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:1px; color:#f5f0e8;">Descrizione</th>
                    <th style="padding:12px 16px; text-align:left; font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:1px; color:#f5f0e8;">Categoria</th>
                    <th style="padding:12px 16px; text-align:center; font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:1px; color:#f5f0e8;">Qtà</th>
                    <th style="padding:12px 16px; text-align:right; font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:1px; color:#f5f0e8;">Prezzo unit.</th>
                    <th style="padding:12px 16px; text-align:right; font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:1px; color:#f5f0e8;">Subtotale</th>
                </tr>
            </thead>
            <tbody>
                @if (righe != null)
                {
                    @for (int i = 0; i < righe.Count; i++)
                    {
                        var riga = righe[i];
                        var articolo = i < articoli.Count ? articoli[i] : null;
                        <tr style="border-bottom:1px solid #ede8e0; background:@(i % 2 == 0 ? "#fff" : "#faf8f5");">
                            <td style="padding:14px 16px; font-weight:500; color:#1c1a18;">@(articolo?.Nome ?? "-")</td>
                            <td style="padding:14px 16px; color:#8a8278; font-size:13px;">@(articolo?.Categoria ?? "-")</td>
                            <td style="padding:14px 16px; text-align:center; color:#1c1a18;">@riga.Quantita</td>
                            <td style="padding:14px 16px; text-align:right; color:#1c1a18;">€ @riga.Prezzo.ToString("0.00")</td>
                            <td style="padding:14px 16px; text-align:right; font-weight:600; color:#1c1a18;">€ @((riga.Quantita * riga.Prezzo).ToString("0.00"))</td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr style="background:#f7f4ef;">
                    <td colspan="3" style="padding:14px 16px;"></td>
                    <td style="padding:14px 16px; text-align:right; font-size:12px; font-weight:600; color:#8a8278;">Imponibile</td>
                    <td style="padding:14px 16px; text-align:right; font-weight:600; color:#1c1a18;">€ @((Model.ImportoTotale / 1.1).ToString("0.00"))</td>
                </tr>
                <tr style="background:#f7f4ef;">
                    <td colspan="3" style="padding:4px 16px;"></td>
                    <td style="padding:4px 16px; text-align:right; font-size:12px; font-weight:600; color:#8a8278;">IVA 10%</td>
                    <td style="padding:4px 16px; text-align:right; font-weight:600; color:#1c1a18;">€ @((Model.ImportoTotale - Model.ImportoTotale / 1.1).ToString("0.00"))</td>
                </tr>
                <tr style="background:#1c1a18;">
                    <td colspan="4" style="padding:16px; text-align:right; font-size:13px; font-weight:600; color:#f5f0e8;">Totale</td>
                    <td style="padding:16px; text-align:right; font-size:1.2rem; font-weight:800; color:#b8936a;">€ @Model.ImportoTotale.ToString("0.00")</td>
                </tr>
            </tfoot>
        </table>

        <!-- FOOTER -->
        <div style="border-top:1px solid #ede8e0; padding-top:20px;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                <div>
                    <div style="font-size:11px; font-weight:600; color:#8a8278; margin-bottom:4px;">Dati societari</div>
                    <div style="font-size:10px; color:#b8b0a8;">Caffè Ritmo S.r.l. — Capitale sociale € 50.000,00 i.v.</div>
                    <div style="font-size:10px; color:#b8b0a8;">Sede legale: Via del Caffè 1, 20121 Milano (MI) — Italia</div>
                    <div style="font-size:10px; color:#b8b0a8;">P.IVA IT04782319028 — C.F. 04782319028 — REA MI-2341892</div>
                    <div style="font-size:10px; color:#b8b0a8;">Iscrizione al Registro Imprese di Milano n. 04782319028</div>
                </div>
                <div style="text-align:right;">
                    <div style="font-size:10px; color:#b8b0a8;">Documento n. @numeroFattura</div>
                    <div style="font-size:10px; color:#b8b0a8;">Emesso il @Model.Data.ToString("dd/MM/yyyy")</div>
                </div>
            </div>
            <div style="margin-top:12px; padding-top:12px; border-top:1px solid #f0e8e4; text-align:center;">
                <div style="font-size:10px; color:#c0b8b0;">
                    ⚠️ Documento non fiscalmente valido — Caffè Ritmo è un progetto didattico simulativo
                </div>
                <div style="font-size:10px; color:#c0b8b0; margin-top:2px;">
                    © 2026 Caffè Ritmo — Powered by Mano Airy e Lorenzo Picci
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script>
    (function() {
        const section = document.getElementById('deliverySection');
        if (!section) return;
        const conferma = new Date(section.dataset.conferma);
        const tempo = parseInt(section.dataset.tempo);
        const fill = document.getElementById('deliveryFill');
        const label = document.getElementById('deliveryTimeLeft');

        function aggiorna() {
            const elapsed = (new Date() - conferma) / 60000;
            const pct = Math.min(elapsed / tempo * 100, 100);
            fill.style.width = pct + '%';
            const rimanenti = Math.max(Math.ceil(tempo - elapsed), 0);
            if (rimanenti > 0) {
                label.textContent = `Consegna stimata tra ${rimanenti} minut${rimanenti === 1 ? 'o' : 'i'}`;
            } else {
                label.textContent = 'In arrivo da un momento all\'altro...';
                setTimeout(() => location.reload(), 5000);
            }
        }
        aggiorna();
        setInterval(aggiorna, 10000);
    })();

    function scaricaFattura() {
        const elemento = document.getElementById('fatturaPdf');
        elemento.style.display = 'block';

        const opt = {
            margin: 0,
            filename: 'fattura-' + '@numeroFattura' + '.pdf',
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: { scale: 2, useCORS: true },
            jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
        };

        html2pdf().set(opt).from(elemento).save().then(() => {
            elemento.style.display = 'none';
        });
    }
</script>
}