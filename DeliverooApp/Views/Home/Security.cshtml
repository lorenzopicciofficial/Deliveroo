@{
    ViewData["Title"] = "Security";
    Layout = "_Layout";
    bool bloccata = ViewBag.RegistrazioneBloccata == true;
}

<style>
    .security-wrapper {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }

    .security-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 32px rgba(0,0,0,0.10);
        padding: 2.5rem 3rem;
        width: 100%;
        max-width: 480px;
    }

    .security-card-title {
        font-size: 1.5rem;
        font-weight: 800;
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .security-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
    }

    .security-row-label {
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.4;
    }

    .security-row-sub {
        font-size: 0.82rem;
        color: #888;
        margin-top: 2px;
    }

    /* Toggle switch */
    .toggle-form { margin: 0; }

    .toggle-switch {
        position: relative;
        display: inline-block;
        width: 56px;
        height: 30px;
        flex-shrink: 0;
    }

    .toggle-switch input { opacity: 0; width: 0; height: 0; }

    .toggle-slider {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background: #ccc;
        border-radius: 30px;
        transition: background 0.25s;
    }

    .toggle-slider::before {
        content: "";
        position: absolute;
        width: 22px;
        height: 22px;
        left: 4px;
        top: 4px;
        background: #fff;
        border-radius: 50%;
        transition: transform 0.25s;
        box-shadow: 0 1px 4px rgba(0,0,0,0.18);
    }

    .toggle-switch input:checked + .toggle-slider {
        background: #f97316;
    }

    .toggle-switch input:checked + .toggle-slider::before {
        transform: translateX(26px);
    }

    .toggle-status {
        margin-top: 2rem;
        padding: 0.75rem 1rem;
        border-radius: 8px;
        font-size: 0.88rem;
        font-weight: 600;
        text-align: center;
    }

    .toggle-status.attiva {
        background: #fff3e0;
        color: #c2410c;
        border: 1px solid #fed7aa;
    }

    .toggle-status.disattiva {
        background: #f0fdf4;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }
</style>

<div class="security-wrapper">
    <div class="security-card">
        <div class="security-card-title">
            Quarantena ⚠️⚠️
        </div>

        <div class="security-row">
            <div>
                <div class="security-row-label">Blocca registrazioni</div>
                <div class="security-row-sub">Rende la pagina di registrazione irraggiungibile</div>
            </div>
            <form method="post" asp-action="ToggleQuarantena" class="toggle-form">
                <label class="toggle-switch" title="@(bloccata ? "Disattiva quarantena" : "Attiva quarantena")">
                    <input type="checkbox" @(bloccata ? "checked" : "") onchange="this.form.submit()"/>
                    <span class="toggle-slider"></span>
                </label>
            </form>
        </div>

        <div class="toggle-status @(bloccata ? "attiva" : "disattiva")">
            @if (bloccata)
            {
                <span>🔒 Registrazioni bloccate — nessun nuovo utente può iscriversi</span>
            }
            else
            {
                <span>✅ Registrazioni aperte</span>
            }
        </div>
    </div>
</div>
